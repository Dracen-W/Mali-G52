# Mali-G52 kernel driver example configuration (values intentionally blank).
# Copy or override these keys in your board/OS config (e.g. UniXNU-merlinx/configs/merlinx-iOS16.7.config).
# UniXNU-merlinx translates these switches into -DCONFIG_XNU_DW_MALIG52_* / -DNATIVE_MALI_M*_WRITES=1.
#
# Supported parameters:
#
# Enable M2 stage hardware writes (MT6358 VGPU/VSRAM PMIC, SPM power domains, topckgen/mfgcfg clocks).
# Values: y | n (default: n unless enabled by board/OS config)
CONFIG_XNU_DW_MALIG52_M2_WRITES=

# Enable M3 stage hardware writes (Mali-G52 soft reset and shader/tiler/L2 core power-on).
# Values: y | n
CONFIG_XNU_DW_MALIG52_M3_WRITES=

# Enable M4 stage hardware writes (Mali-G52 MMU address space and page table programming).
# Values: y | n
CONFIG_XNU_DW_MALIG52_M4_WRITES=

# Enable M6 stage hardware writes (job-slot submission and fence completion interrupts).
# Values: y | n
CONFIG_XNU_DW_MALIG52_M6_WRITES=

# Diagnostic log verbosity (0 = quiet, 1 = normal bring-up status, 2 = verbose).
CONFIG_XNU_DW_MALIG52_LOG_LEVEL=
